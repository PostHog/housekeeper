logging:
  level: "info"  # Options: trace, debug, info, warn, error, fatal, panic
  format: "text" # Options: text, json
clickhouse:
  host: "127.0.0.1"
  port: 9000
  user: "default"
  password: "default"
  # Optional file holding a rotating token, read on every connect. An unreadable
  # or empty file uses the password above, and so does an expired token when a
  # password is set.
  password_file: ""
  database: "default"
  cluster: "default"
  # List of databases the MCP server is allowed to query
  # If not specified, defaults to ["system"]
  allowed_databases:
    - "system"
    - "models"
  # As an env var, a comma- or space-separated list:
  # HOUSEKEEPER_CLICKHOUSE_ALLOWED_DATABASES="system,models"
  max_result_rows: 10000       # clickhouse_query stops here and reports truncated (negative = no cap)
  query_timeout_seconds: 90    # per clickhouse_query call; keep below the role's max_execution_time
  # TLS. The defaults keep the historic behavior: TLS on, certificate not verified.
  # Set secure: false for a plaintext server (e.g. docker-compose's 9000).
  secure: true
  tls_skip_verify: true
  ca_file: ""                  # PEM CA bundle to verify the server; use with tls_skip_verify: false
  server_name: ""              # expected certificate name, when it differs from host
prometheus:
  host: "localhost"
  port: 8481
  # VictoriaMetrics cluster mode settings
  vm_cluster_mode: false  # Set to true for VM cluster mode
  vm_tenant_id: "0"      # Tenant ID for VM cluster mode
  vm_path_prefix: ""     # Optional path prefix (e.g. "prometheus" for VM)
  query_timeout_seconds: 30
# HTTP server (enables network-accessible MCP for Kubernetes/remote deployments)
http:
  addr: ":8080"           # Listen address
  auth_token: ""          # Bearer token clients must present (leave empty to disable auth)
  session_timeout_seconds: 1800     # idle MCP sessions are closed after this
  read_header_timeout_seconds: 10
  shutdown_timeout_seconds: 25      # on SIGTERM, how long to wait for running work before cancelling it

# Optional: deployment-specific guidance for MCP clients.
# - extra_tool_description: shared facts (topology, clusters, attribution columns,
#   query patterns), appended to BOTH clickhouse_query and the diagnose agent.
# - query_extra_description: appended ONLY to clickhouse_query, for restricted-route
#   caveats (column REVOKEs etc.) that don't apply to the elevated diagnose connection.
# Env vars: HOUSEKEEPER_MCP_EXTRA_TOOL_DESCRIPTION, HOUSEKEEPER_MCP_QUERY_EXTRA_DESCRIPTION
mcp:
  extra_tool_description: ""
  query_extra_description: ""

# Optional: in-account Bedrock-backed diagnose tool. When both region and
# model_id are set, the MCP exposes a server-side agent that investigates the
# cluster and returns only a summary. Credentials come from the default AWS
# chain (in-cluster: the pod's IRSA role; no static keys).
# Env var equivalents: HOUSEKEEPER_BEDROCK_REGION, HOUSEKEEPER_BEDROCK_MODEL_ID
bedrock:
  region: ""             # AWS region for Bedrock (match the data's region)
  model_id: ""           # Bedrock model or inference-profile id (set per deployment)
  max_tokens: 2048
  max_iterations: 8      # max run_sql round-trips per diagnosis
  # Every budget below is clamped to max_seconds. Left unset, max_seconds is 25,
  # which also caps the two default budgets at 25s.
  max_seconds: 180       # wall-clock CAP per diagnosis; on exceed, summarize instead of timing out (0 = off)
  default_seconds: 35    # clickhouse_diagnose budget when the caller omits budget_seconds; fits a ~60s client tool timeout
  async_default_seconds: 120  # clickhouse_diagnose_async budget when the caller omits budget_seconds
  max_concurrent_jobs: 3      # concurrent diagnoses allowed, sync and async together
  # Per run_sql deadline, also bounded by the time left in the budget. The driver
  # sends deadline + 5s as max_execution_time, so keep this at least 5s below the
  # analyst profile's max_execution_time.
  max_query_seconds: 60
  temperature: -1        # < 0 = don't send. Sonnet 5+ rejects the parameter; set >= 0 only for older models

# Optional separate ClickHouse connection used only by the diagnose agent.
# Leave user empty to fall back to the clickhouse.* connection above.
# Env var equivalents: HOUSEKEEPER_ANALYST_CLICKHOUSE_USER, ..._PASSWORD, ..._PASSWORD_FILE
analyst_clickhouse:
  host: ""               # empty = reuse clickhouse.host
  port: 0                # 0 = reuse clickhouse.port
  user: ""               # a dedicated user for the diagnose agent
  password: ""
  password_file: ""      # same behavior as clickhouse.password_file
  database: ""           # empty = reuse clickhouse.database
  # secure, tls_skip_verify, ca_file, server_name: unset = follow clickhouse.*
